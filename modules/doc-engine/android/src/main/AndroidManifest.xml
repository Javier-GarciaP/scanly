<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <package android:name="com.google.android.gms" />
    <intent>
      <action android:name="com.google.android.gms.mlkit.ACTION_SCAN_DOCUMENT" />
    </intent>
  </queries>
  <application>
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="document_scanner,ocr" />
  </application>
</manifest>
